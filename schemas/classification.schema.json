{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jlpt-levels/schemas/classification-v2",
  "title": "JLPT classification with evidence and conflicts",
  "type": "object",
  "additionalProperties": false,
  "required": ["lexemeId", "level", "method", "confidence", "conflict", "evidence", "policy"],
  "properties": {
    "lexemeId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "level": {"enum": ["N5", "N4", "N3", "N2", "N1", "N0"]},
    "method": {"enum": ["direct", "inferred", "adjudicated"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "conflict": {"type": "boolean"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
        "selectedEvidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:[0-9a-f]{64}$"}}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "sourceId", "sourceRecord", "snapshotSha256", "capturedAt", "assertedLevel"],
        "properties": {
          "evidenceId": {"type": "string", "pattern": "^evidence:[0-9a-f]{64}$"},
          "sourceId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "sourceRecord": {"type": "string", "minLength": 1},
          "snapshotSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "capturedAt": {"type": "string", "format": "date-time"},
          "assertedLevel": {"enum": ["N5", "N4", "N3", "N2", "N1"]},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "postN1DifficultySignals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "promptVersion", "inputSha256", "outputSha256", "batchSize", "runAt"],
      "properties": {
        "provider": {"const": "bedrock"},
        "model": {"const": "global.openai.gpt-5.6-luna"},
        "promptVersion": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
        "inputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "outputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "batchSize": {"type": "integer", "minimum": 1, "maximum": 3},
        "runAt": {"type": "string", "format": "date-time"}
      }
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["unresolved-direct-evidence-conflict"]}
    }
  },
  "allOf": [
    {"if": {"properties": {"method": {"const": "direct"}}, "required": ["method"]}, "then": {"properties": {"level": {"not": {"const": "N0"}}, "evidence": {"minItems": 1}, "policy": {"required": ["selectedEvidenceIds"], "properties": {"selectedEvidenceIds": {"minItems": 1}}}}, "not": {"required": ["adjudication"]}}},
    {"if": {"properties": {"method": {"const": "inferred"}}, "required": ["method"]}, "then": {"properties": {"evidence": {"maxItems": 0}, "policy": {"not": {"required": ["selectedEvidenceIds"]}}}, "required": ["features"], "not": {"required": ["adjudication"]}}},
    {"if": {"properties": {"method": {"const": "adjudicated"}}, "required": ["method"]}, "then": {"properties": {"evidence": {"maxItems": 0}, "policy": {"not": {"required": ["selectedEvidenceIds"]}}}, "required": ["features", "adjudication"]}},
    {"if": {"properties": {"level": {"const": "N0"}}, "required": ["level"]}, "then": {"required": ["features"], "properties": {"features": {"required": ["postN1DifficultySignals"]}}}}
  ]
}
